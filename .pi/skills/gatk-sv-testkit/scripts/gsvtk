#!/usr/bin/env bash
# gsvtk — the skill's shim in front of a gatk-sv-testkit checkout's own ./gsvtk.
#
# This used to be the whole dispatcher (377 lines: read-only whitelist, per-tool flag dispatch, the
# build preview, the redacted doctor). All of that now lives in the repo, at the repo root, as
# ./gsvtk, where a person gets the same contract as an agent does. What stays HERE is the three
# things only the skill can do, because they are about *which checkout* you are allowed to drive
# rather than about what to do once you are in it:
#
#   1. Discovery. The checkout's location is machine-specific, and it is the first thing every
#      session needs and the first thing a fresh agent gets wrong.
#   2. Trust. A git clone whose origin you named (GSVTK_TRUSTED_REPOS) is a checkout; a flattened
#      pile of testkit-shaped files is not. See valid()/trusted() for what that bought.
#   3. The read-only stamp. It execs the repo CLI with GSVTK_READ_ONLY=1, and prints its own
#      version on stderr so a transcript says which shim drove which tree at which version. An
#      unstamped stale copy of a skill is indistinguishable from a current one -- which is how a
#      previous audit ended up quoting code that did not exist. Bump VERSION with the skill's own
#      git tag; scripts/check_skill.py pins it against SKILL.md's metadata.version.
#
# Deliberately absent here, as before: submit, create, copy, attrs --write, push, fetch, profile.
# Those are either money or bulk transfer, and the repo CLI refuses them under GSVTK_READ_ONLY=1
# (docs/cli.md is the contract). This shim does not decide that any more -- it only sets the flag
# that makes the repo CLI decide it, so there is one dispatcher and one place the rules live.
#
# bash 3.2-compatible (macOS default): no arrays-of-hashes, no mapfile, no ${v,,}.

set -uo pipefail

REPO="${GSVTK_HOME:-}"

# Stamped, because this skill lives outside the repo it drives.
VERSION="0.6.0"

die() { printf 'gsvtk: %s\n' "$*" >&2; exit 2; }

# Two independent gates, because they fail for different reasons:
#   valid()   -- is this a testkit at all?      (structure)
#   trusted() -- is it the testkit you meant?   (a git checkout whose origin you named)
# Structure used to be the whole test, on the reasoning that a renamed or vendored copy should still
# work. That reasoning cost more than it saved: a scratch directory of flattened testkit files --
# copied compare/recon/fetch scripts, no .git, and a CHECKPOINT.md full of some earlier session's
# stale state -- reads to an agent as "the checkout", and work done there runs stale code against
# whatever coordinates happen to be in the ambient environment, with no profile and no sha to say
# what ran. A renamed clone still passes; a pile of copied files, and any remote you did not list,
# does not.
valid() { [ -n "$1" ] && [ -f "$1/kit/gsvtk-config" ] && [ -d "$1/terra" ] && [ -d "$1/checks" ]; }

# Entries are host/owner/repo, comma-separated, and are matched in both the URL form
# (github.com/o/r) and the scp form (github.com:o/r), so https, ssh:// and git@ clones all agree.
TRUSTED_REPOS="${GSVTK_TRUSTED_REPOS:-github.com/talkowski-lab/gatk-sv-testkit}"

trusted() {
  local r t
  r="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  [ -n "$r" ] || return 1
  for t in $(printf '%s' "$TRUSTED_REPOS" | tr ',' ' '); do
    case "$r" in
      *"$t"*) return 0 ;;                      # .../host/owner/repo[.git]
      *"${t%%/*}:${t#*/}"*) return 0 ;;        # host:owner/repo[.git]
    esac
  done
  return 1
}

# Why a search failed, so an explicit GSVTK_HOME pointing at the wrong tree says so instead of
# echoing the generic "clone it" advice back at someone who has eleven checkouts.
REPO_NOTE=""

find_repo() {
  if [ -n "$REPO" ]; then                       # explicit GSVTK_HOME: honour it or say why not
    if ! valid "$REPO"; then
      REPO_NOTE="GSVTK_HOME=$REPO is not a gatk-sv-testkit checkout (needs kit/gsvtk-config, terra/, checks/)."
      return 1
    fi
    if ! trusted "$REPO"; then
      REPO_NOTE="GSVTK_HOME=$REPO is structurally a testkit but its origin is not trusted.
  origin is: $(git -C "$REPO" remote get-url origin 2>/dev/null || printf '(none -- not a git checkout, or no origin)')
  trusted is: $TRUSTED_REPOS
  Add it if you mean to: export GSVTK_TRUSTED_REPOS=\"$TRUSTED_REPOS,github.com/<you>/<fork>\""
      return 1
    fi
    REPO="$(cd "$REPO" && pwd -P)"; return 0
  fi
  # $PWD first: the common case is being asked about the repo you are already standing in.
  for c in "$PWD" "$PWD/gatk-sv-testkit" "$PWD/../gatk-sv-testkit"; do
    valid "$c" && trusted "$c" && { REPO="$(cd "$c" && pwd -P)"; return 0; }
  done
  for root in "$HOME/IdeaProjects" "$HOME/Work" "$HOME/src" "$HOME/projects" "$HOME"; do
    [ -d "$root" ] || continue
    # -maxdepth 2 covers <root>/<checkout> and <root>/<parent>/<checkout> without a full scan
    while IFS= read -r c; do
      # An untrusted candidate is skipped, not fatal: the right checkout may be the next one.
      valid "$c" && trusted "$c" && { REPO="$(cd "$c" && pwd -P)"; return 0; }
    done < <(find "$root" -maxdepth 2 -type d -name 'gatk-sv-testkit*' 2>/dev/null)
  done
  return 1
}

need_repo() {
  find_repo && return 0
  [ -n "$REPO_NOTE" ] && die "$REPO_NOTE"
  die "no gatk-sv-testkit checkout found.
  set GSVTK_HOME=/path/to/gatk-sv-testkit, or clone it:
    git clone https://github.com/talkowski-lab/gatk-sv-testkit.git && cd gatk-sv-testkit && make setup"
}

need_repo

# The compatibility guard: skill 0.6.0 drives a checkout that carries the entry point. Without this
# the exec would fail with a bare "no such file or directory" and read as a broken skill.
[ -x "$REPO/gsvtk" ] || die "the checkout at $REPO has no executable ./gsvtk, and this skill (v$VERSION) needs one.
  Update the checkout:  cd $REPO && git pull   (the entry point landed with the single-command-line
  change). The older skill that matches that tree still dispatches read-only modes itself."

# Read-only is not a default the caller can forget to set: the skill IS the read-only boundary, and
# the repo CLI refuses the POSTing / booting / bulk-download modes on the strength of this flag.
# GSVTK_SKILL_VERSION lets `gsvtk version` and `locate` report the pair (see check_skill.py).
export GSVTK_READ_ONLY=1 GSVTK_SKILL_VERSION="$VERSION"

# Stamp the shim itself on stderr before handing over; the repo CLI stamps the resolved
# `path @ sha` on stderr for every command that runs repo code, so the pair lands in the transcript
# in the order a reader wants it. stderr, because `cd "$(scripts/gsvtk repo)"` captures stdout.
#
# This used to be a `case "${1:-help}" in check|gate|build|terra|compare|replay|help|...)` list, and the
# list was the defect: both branches exec the same thing, so the only behavior it could produce was a
# command that runs repo code WITHOUT a stamp -- which is precisely what the stamp exists to prevent,
# and it would have appeared the day someone added a subcommand here and not there. An unknown mode
# still gets a line, because the CLI is about to refuse it and a transcript that says which wrapper ran
# is worth having even then. Unconditional: nothing to forget to update.
printf 'skill   gsvtk %s (read-only wrapper) -> %s\n' "$VERSION" "$REPO/gsvtk" >&2

cd "$REPO" || die "cd failed: $REPO"
exec "$REPO/gsvtk" "$@"
