#!/usr/bin/env bash
# gsvtk — the command-line entry point for gatk-sv-testkit.
#
# One dispatcher for the repo's tools. Every tool still runs directly and keeps its own --help, gates
# and exit codes; this only routes to them. docs/cli.md has the command-to-tool map and the
# read-only contract. The agent skill (skills/gatk-sv-testkit) runs this with --read-only.
#
# Read-only contract:
#   1. GSVTK_READ_ONLY=1 or a global --read-only refuses every mode that POSTs, boots compute or
#      bulk-downloads. The refusal happens before any dependency or config probe, so it reads the
#      same on every machine. Exit 2, naming the mode and the command to run by hand.
#   2. Mutating modes also require --confirm and print what, where, cost and undo before acting.
#      This is an outer gate: a tool's own --confirm / --write / --allow-shared-target still applies.
#      --confirm is forwarded only to tools that document it.
#   3. Plan modes (--check, --dry-run, fetch --verify) are free and run under read-only.
#
# The only environment variable this writes is GSVTK_MODULE (from --module), for the child tool;
# kit/gsvtk-config resolves it like any other env value.
#
# Exit codes:
#   0 clean | 1 findings or a real failure | 2 usage error / refused mode |
#   3 missing dependency (named, with the install or the export to run) |
#   4 missing required config (the resolver's own code; see docs/config.md)
# No args or an unknown subcommand prints usage and exits 2; --help exits 0.
#
# bash 3.2-compatible (macOS default): no mapfile, no associative arrays, no ${v,,}.

set -uo pipefail

# Follow symlinks to this file, so a link on PATH still finds the checkout.
SELF="${BASH_SOURCE[0]:-$0}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link";; *) SELF="$(dirname "$SELF")/$link";; esac
done
ROOT="$(cd "$(dirname "$SELF")" && pwd -P)"
VENV=".venv/bin/python"
VENVBIN=".venv/bin"

READ_ONLY="${GSVTK_READ_ONLY:-}"
CONFIRM=0
STRIPPED=()

die() { printf 'gsvtk: %s\n' "$*" >&2; exit 2; }

# Every real value comes from kit/gsvtk-config. The only GSVTK_* variables read directly are
# per-invocation transport knobs: GSVTK_READ_ONLY, GSVTK_TERRA_PY, GSVTK_PY.
cfg() { ( cd "$ROOT" && "${PY:-python3}" ./kit/gsvtk-config get "$1" 2>/dev/null ); }

# join "$@" — space-joined arguments, for display only; execution uses the real array.
join() { local out="" a; for a in "$@"; do out="$out$a "; done; printf '%s' "${out% }"; }

# terra/ needs firecloud and compare/ needs numpy/pandas/pysam, typically from the checkout's venv.
py_for() {
  case "$1" in
    terra)  if [ -n "${GSVTK_TERRA_PY:-}" ] && "$GSVTK_TERRA_PY" -c 'import firecloud' 2>/dev/null; then
              printf '%s' "$GSVTK_TERRA_PY"
            elif [ -x "$ROOT/$VENV" ] && "$ROOT/$VENV" -c 'import firecloud' 2>/dev/null; then
              printf '%s' "$ROOT/$VENV"
            elif python3 -c 'import firecloud' 2>/dev/null; then
              printf 'python3'
            else
              return 1
            fi ;;
    *)      if [ -n "${GSVTK_PY:-}" ] && [ -x "$GSVTK_PY" ]; then
              printf '%s' "$GSVTK_PY"           # like GSVTK_TERRA_PY, for the other tools
            elif [ -x "$ROOT/$VENV" ]; then printf '%s' "$ROOT/$VENV"; else printf 'python3'; fi ;;
  esac
}

# Ask `kit/gsvtk-config miniwdl` so there is one resolution order ($MINIWDL -> PATH -> interpreter's
# bin -> <repo>/.venv/bin). The fallback below is for a tree without that subcommand.
miniwdl_bin() {
  if [ -f "$ROOT/kit/gsvtk-config" ]; then
    m="$( (cd "$ROOT" && ./kit/gsvtk-config miniwdl) 2>/dev/null )"
    [ -n "$m" ] && { printf '%s' "$m"; return 0; }
    [ -n "${MINIWDL:-}" ] && return 1        # asked for explicitly and the checkout says unusable
  fi
  if [ -n "${MINIWDL:-}" ] && command -v "$MINIWDL" >/dev/null 2>&1; then printf '%s' "$MINIWDL"
  elif command -v miniwdl >/dev/null 2>&1; then printf 'miniwdl'
  elif [ -x "$ROOT/$VENVBIN/miniwdl" ]; then printf '%s' "$ROOT/$VENVBIN/miniwdl"
  else return 1; fi
}

git_sha() { git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf 'no-commit'; }
git_dirty() { [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ] && printf ' +dirty'; }

# Print which checkout is running, on stderr (stdout may be captured, e.g. `cd "$(gsvtk repo)"`).
stamp() {
  printf 'repo  %s @ %s%s\n' "$ROOT" "$(git_sha)" "$(git_dirty)" >&2
}

read_only_on() { [ -n "$READ_ONLY" ] && [ "$READ_ONLY" != "0" ]; }

# ------------------------------------------------------------------ the gates
# Plan-only exemptions are decided per tool and mode, never by scanning argv for --check/--dry-run:
# a tool that doesn't implement the flag would ignore it and do the real write.

# has_flag FLAG "$@" — is the flag present in the forwarded argument list?
has_flag() {
  local want="$1"; shift
  local a
  for a in "$@"; do [ "$a" = "$want" ] && return 0; done
  return 1
}

# strip_confirm "$@" — fill STRIPPED with the arguments minus this gate's own --confirm. Used when
# the target tool does NOT document --confirm and would reject it as an unknown argument.
strip_confirm() {
  STRIPPED=()
  local a
  for a in "$@"; do [ "$a" = "--confirm" ] && continue; STRIPPED+=("$a"); done
}

# refuse_readonly MODE TARGET-COMMAND [detail] — the read-only refusal, before any dependency or
# config check.
refuse_readonly() {
  local mode="$1" command="$2" detail="${3:-}"
  printf 'gsvtk: REFUSED — %s POSTs, boots compute, or bulk-downloads, and this run is read-only.\n' \
    "$mode" >&2
  [ -n "$detail" ] && printf '       %s\n' "$detail" >&2
  printf '       Nothing was submitted, downloaded or created, and no dependency, credential or\n' >&2
  printf '       config value was consulted: this is a policy refusal, not a broken environment.\n' >&2
  printf '       Read-only is the default because one whole-chain rerun is a fleet of VMs and Terra\n' >&2
  printf '       has no per-workspace budget cap (CONTRIBUTING: "Mutating vs read-only").\n' >&2
  printf '       To do it, step out of read-only and run it yourself, in the checkout:\n' >&2
  printf '         cd %s && %s\n' "$ROOT" "$command" >&2
  printf '       (or drop GSVTK_READ_ONLY / the --read-only flag and add --confirm: the outer gate\n' >&2
  printf '        still wants the write spelled out before it acts.)\n' >&2
  exit 2
}

# need_confirm MODE DETAIL — the outer gate for a mutating mode. The inner gate stays the tool's.
need_confirm() {
  local mode="$1" detail="$2"
  if [ "$CONFIRM" = 1 ]; then return 0; fi
  printf 'gsvtk: refusing "%s" — it %s, and mutating modes need --confirm.\n' "$mode" "$detail" >&2
  printf '       Nothing was created, POSTed, booted or downloaded.\n' >&2
  printf '       Ask the free version of the same question first: show / plan / check / --dry-run\n' >&2
  printf '       print the target and the object count without writing anything.\n' >&2
  printf '       Run it when you mean it:\n' >&2
  printf '         gsvtk %s --confirm\n' "$mode" >&2
  printf "       (the tool's own gate still applies: --write, --allow-shared-target, and whatever\n" >&2
  printf '        preflight it prints before it POSTs. This gate does not replace those.)\n' >&2
  exit 2
}

# announce_write WHAT WHERE COST UNDO — the four things printed BEFORE a write happens.
# No prices are quoted: cost is given as machine type, size or VM-minutes.
announce_write() {
  printf 'gsvtk: MUTATING mode — what happens next, before it happens:\n' >&2
  printf '  what   %s\n' "$1" >&2
  printf '  where  %s\n' "$2" >&2
  printf '  cost   %s\n' "$3" >&2
  printf '  undo   %s\n' "$4" >&2
}

# An unconfigured Terra target prints the keys to set rather than an empty path.
ws_target() {
  local ns ws
  ns="$(cfg TERRA_NAMESPACE)"; ws="$(cfg TERRA_WORKSPACE)"
  if [ -z "$ns" ] || [ -z "$ws" ]; then
    printf '(unset — GSVTK_TERRA_NAMESPACE / GSVTK_TERRA_WORKSPACE: the tool exits 4 naming them)'
  else
    printf '%s/%s' "$ns" "$ws"
  fi
}

# ------------------------------------------------------------------ locate / doctor / tools
cmd_locate() {
  printf 'gsvtk     repo CLI @ %s%s\n' "$(git_sha)" "$(git_dirty)"
  printf 'repo      %s\n' "$ROOT"
  if [ -d "$ROOT/.git" ]; then
    printf 'git       %s @ %s\n' "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)" \
      "$(git_sha)"
    [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ] && \
      printf '          working tree has uncommitted changes (docs may not match code)\n'
  fi
  if [ -x "$ROOT/$VENV" ]; then printf 'venv      present (%s)\n' "$VENV"; else
    printf 'venv      MISSING — run: cd %s && make setup\n' "$ROOT"; fi
  for t in jq gsutil gcloud bcftools; do
    command -v "$t" >/dev/null 2>&1 && printf 'tool      %s\n' "$t" || printf 'tool      %s absent\n' "$t"
  done
  if wdlbin="$(miniwdl_bin)"; then printf 'tool      miniwdl (%s)\n' "$wdlbin"
  else printf 'tool      miniwdl absent\n'; fi
}

# Plain doctor prints real values; --redact shows only whether each key is set and its source.
cmd_doctor() {
  # Reject unknown flags: a typo must not fall through to the unredacted branch.
  case "${1:-}" in
    '')       redact=0 ;;
    --redact) redact=1 ;;
    *)        die "doctor: unknown flag '$1' (the only flag is --redact). Refusing to print values." ;;
  esac
  # if/fi rather than `&&`, so the statement doesn't return 1 under a future `set -e`.
  if [ "$#" -gt 1 ]; then die "doctor: unexpected argument '$2' (usage: gsvtk doctor [--redact])"; fi
  if [ "$redact" != 1 ]; then
    printf 'doctor: UNREDACTED coordinates follow. To report state, use: gsvtk doctor --redact\n' >&2
    ( cd "$ROOT" && ./kit/gsvtk-config doctor ); return $?
  fi

  # Redacted view: files consulted, missing keys, and each key's source but not its value.
  # Values from env/profile/derived are masked; shipped defaults are shown.
  ( cd "$ROOT" && ./kit/gsvtk-config doctor ) 2>&1 | sed -n '/^profiles read:/,/^$/p'
  ( cd "$ROOT" && ./kit/gsvtk-config doctor ) 2>&1 | grep -E '^  MISS ' | sed 's/^  MISS /  MISSING /'
  ( cd "$ROOT" && ./kit/gsvtk-config show ) 2>&1 | awk '
    # Columns from gsvtk-config show:  <flag> <KEY> <value...> [<source>]
    # Split on the LAST bracket group: values can contain brackets.
    {
      line = $0
      flag = substr(line, 1, 1)
      rest = substr(line, 3)
      key  = rest; sub(/[ \t].*/, "", key)
      lb = 0; rb = 0
      for (i = length(line); i > 1; i--) { c = substr(line, i, 1)
        if (rb == 0 && c == "]") rb = i
        if (rb > 0 && c == "[") { lb = i; break } }
      if (lb == 0) { print; next }
      src   = substr(line, lb + 1, rb - lb - 1)
      value = substr(line, length(flag) + 1 + length(key) + 1, lb - (length(key) + length(flag) + 3))
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      mine = (src ~ /^(env|profile|derived)/)
      printf "  %-4s %-22s %-34s [%s]\n", (flag == "!" ? "MISS" : ""), key,
             (mine && value != "(unset)" ? "<set, redacted>" : value), src
    }'
  printf '\n(values hidden: keys whose value comes from your environment, your profile, or is\n derived from your project. Shipped defaults are shown as-is.)\n'
}

# Which loops can run on this machine. Its output format is quoted in docs; keep it stable.
cmd_tools() {
  printf 'checkout  %s\n' "$ROOT"
  ck="$(cfg GATK_SV_CHECKOUT)"
  if [ -n "$ck" ] && [ -d "$ck" ]; then
    printf 'gatk-sv   %s @ %s\n' "$ck" "$(git -C "$ck" rev-parse --short HEAD 2>/dev/null)"
  else printf 'gatk-sv   unset — set GSVTK_GATK_SV_CHECKOUT to run checks/ and fetch_wdl\n'; fi
  if p="$(py_for terra)"; then printf 'terra     %s\n' "$p"
  else printf 'terra     unavailable — no firecloud. cd %s && make setup, or export GSVTK_TERRA_PY=<python that has it>\n' "$ROOT"; fi
  # Print where miniwdl resolved from.
  if wdlbin="$(miniwdl_bin)"; then printf 'wdl_gate  ok (%s)\n' "$wdlbin"
  else printf 'wdl_gate  needs miniwdl — cd %s && make setup, or python -m pip install -r requirements-dev.txt (export MINIWDL=<path> to point at one elsewhere)\n' "$ROOT"; fi
  command -v jq >/dev/null 2>&1 \
    && printf 'jq scan   ok\n' || printf 'jq scan   needs jq\n'
  # build needs gcloud; `terra inputs` needs a JDK for womtool. Replay blockers are left to
  # `gsvtk replay preflight` to keep this probe fast.
  command -v gcloud >/dev/null 2>&1 \
    && printf 'build     gcloud ok\n' || printf 'build     needs gcloud (no VM without it)\n'
  if ! command -v java >/dev/null 2>&1; then printf 'inputs    needs a JDK (womtool is a jar)\n'
  elif [ -z "${WOMTOOL_JAR:-}" ] || [ ! -f "${WOMTOOL_JAR:-}" ]; then
    printf 'inputs    java ok, WOMTOOL_JAR unset/missing — export WOMTOOL_JAR=/path/womtool.jar (terra/batch_check_inputs.py AND the gate: check prints the required-input gap without it, the womtool verdict with it)\n'
  else printf 'inputs    ok (%s)\n' "$WOMTOOL_JAR"; fi
}

# ------------------------------------------------------------------ check
# The static checks, in cost order. Flags are routed to the tool that owns them: --wf/--strict to
# wdl_gate.sh, --repo to the python checkers, --compare-to to the jq plumbing scan.
#   check [<ref>] [--wf NAME ...] [--strict] [--repo DIR] [--compare-to REF] [--semantics] [--reach]
#   (--reach also needs at least one --wf NAME: it is the target, see below.)
# check_rc STATUS -- fold one checker's exit into $rc: findings (1) outrank a missing prerequisite (3).
check_rc() {
  case "$1" in
    0) ;;
    3) [ "$rc" = 0 ] && rc=3 ;;
    *) rc=1 ;;
  esac
}

cmd_check() {
  stamp
  if [ -z "${MINIWDL:-}" ] && wdlbin="$(miniwdl_bin)"; then MINIWDL="$wdlbin"; export MINIWDL; fi
  ref=""; wfargs=(); pyargs=(); compare_to=""; want_sem=0; want_reach=0; want_images=0; reach_targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)    printf '%s\n' "usage: gsvtk check [<ref>] [--wf NAME]... [--strict] [--repo DIR]"
                   printf '%s\n' "                  [--compare-to REF] [--semantics] [--reach [--images]]"
                   printf '%s\n' ''
                   printf '%s\n' '  <ref>            run wdl_gate.sh against that ref (its per-ref count is the output)'
                   printf '%s\n' '  --wf NAME        workflow(s) to gate; repeatable. With --reach, NAME is also the'
                   printf '%s\n' '                   reach target -- every name is answered, by ONE wdl_reach run'
                   printf '%s\n' '                   (one tree load), so --reach needs at least one'
                   printf '%s\n' '  --strict         gate: treat warnings as findings'
                   printf '%s\n' '  --repo DIR       tree the python checkers read (default: GSVTK_GATK_SV_CHECKOUT)'
                   printf '%s\n' '  --compare-to REF jq plumbing scan: fail only on nulls this ref introduced'
                   printf '%s\n' '  --semantics      wdl_semantics.py (tree-wide, opt-in: it is slow, not free)'
                   printf '%s\n' '  --reach          wdl_reach.py over the tree, once, answering every --wf NAME:'
                   printf '%s\n' '                   what that name reaches (--reverse is not exposed here; run the'
                   printf '%s\n' '                   tool directly for that)'
                   printf '%s\n' '  --images         with --reach only: also print the container images the reached set'
                   printf '%s\n' '                   binds, and which of them a run would NOT build. The render knobs'
                   printf '%s\n' '                   (--inputs-root/--checkout/--head-sha) stay on the tool itself.'
                   printf '%s\n' ''
                   printf '%s\n' 'Exit codes: 0 clean, 1 a checker reported findings (findings are not a verdict),'
                   printf '%s\n' '          2 usage error (nothing ran), 3 a prerequisite is missing (and nothing reported findings).'
                   return 0;;
      --wf)         wfargs+=(--wf "${2:?--wf needs a workflow name}")
                    reach_targets+=("${2:?--wf needs a workflow name}"); shift 2;;
      --strict)     wfargs+=(--strict); shift;;
      --repo)       pyargs=(--repo "${2:?--repo needs a directory}"); shift 2;;
      --compare-to) compare_to="${2:?--compare-to needs a ref}"; shift 2;;
      --semantics)  want_sem=1; shift;;
      --images)     want_images=1; shift;;
      --reach)      want_reach=1; shift;;
      -*)           die "check: unknown flag $1 (usage: gsvtk check [<ref>] [--wf NAME]... [--strict] [--repo DIR] [--compare-to REF] [--semantics] [--reach]; --reach needs at least one --wf NAME)";;
      *)            ref="$1"; shift;;
    esac
  done
  cd "$ROOT" || die "cd failed"
  rc=0
  # Default the tree for the python checkers from the resolver; if it is empty, pass nothing and let
  # each tool report what it needs.
  if [ ${#pyargs[@]} -eq 0 ]; then
    ck="$(cfg GATK_SV_CHECKOUT)"
    [ -n "$ck" ] && pyargs=(--repo "$ck")
  fi
  # wdl_reach.py has no default target, so --reach without --wf is a usage error.
  if [ "$want_reach" = 1 ] && [ ${#reach_targets[@]} -eq 0 ]; then
    die "check --reach needs a target: pass --wf NAME (repeatable), e.g.
  ./gsvtk check --reach --wf GenotypeBatch
  wdl_reach has no default target: it answers NAMED files, workflows, tasks and scripts, one
  answer per --wf NAME from a single tree load. There is no default target, because a reach
  answer about the wrong file is worse than no answer."
  fi
  # --images only qualifies --reach; without it there is no reached set to list images for.
  if [ "$want_images" = 1 ] && [ "$want_reach" != 1 ]; then
    die "check --images needs --reach: the image list is what the REACHED set binds, and with no
  target there is no reached set to ask. Pass both, e.g.
  ./gsvtk check --reach --images --wf GenotypeBatch"
  fi
  if [ -n "$ref" ]; then
    printf '\n=== wdl_gate.sh %s ===\n' "$ref"
    bash checks/wdl_gate.sh ${wfargs[@]+"${wfargs[@]}"} "$ref" || check_rc $?
  else
    printf '\n(no ref given: skipping wdl_gate, whose whole output is a per-ref count)\n'
  fi
  printf '\n=== svshell_contract_check.py ===\n'
  "$PY" checks/svshell_contract_check.py ${pyargs[@]+"${pyargs[@]}"} || {
    st=$?; [ "$st" = 1 ] && printf '  (findings, not a verdict: diff this list against your base ref)\n'; check_rc "$st"; }
  if command -v jq >/dev/null 2>&1; then
    printf '\n=== svshell_jq_plumbing_scan.py ===\n'
    if [ -n "$compare_to" ] || [ -n "$ref" ]; then
      # --compare-to is the gate form: only nulls this ref introduced fail.
      "$PY" checks/svshell_jq_plumbing_scan.py ${pyargs[@]+"${pyargs[@]}"} \
        --compare-to "${compare_to:-$ref}" || check_rc $?
    else
      "$PY" checks/svshell_jq_plumbing_scan.py ${pyargs[@]+"${pyargs[@]}"} || {
        st=$?; [ "$st" = 1 ] && printf '  (absolute scan: red on unmodified gatk-sv by design; pass a ref or --compare-to)\n'
        check_rc "$st"; }
    fi
  else
    printf '\njq absent: skipping the jq plumbing scan\n'
  fi
  # Opt-in checkers: both parse the whole tree, so they are slow.
  if [ "$want_sem" = 1 ]; then
    printf '\n=== wdl_semantics.py ===\n'
    "$PY" checks/wdl_semantics.py ${pyargs[@]+"${pyargs[@]}"} || check_rc $?
  fi
  if [ "$want_reach" = 1 ]; then
    # One wdl_reach.py run with repeated --target: loading the tree is the main cost. An unknown name
    # is reported by name (exit 2) without hiding the others.
    reach_names=""; reach_flags=()
    for t in ${reach_targets[@]+"${reach_targets[@]}"}; do
      reach_names="${reach_names:+$reach_names, }$t"
      reach_flags+=(--target "$t")
    done
    # --images costs extra, so it stays opt-in.
    [ "$want_images" = 1 ] && reach_flags+=(--images)
    # Image verdicts are about a commit: when a ref was named, check against it rather than the
    # checkout's HEAD.
    if [ "$want_images" = 1 ] && [ -n "$ref" ]; then
      reach_flags+=(--inputs-ref "$ref")
    fi
    printf '\n=== wdl_reach.py %s ===\n' "$reach_names"
    "$PY" checks/wdl_reach.py ${pyargs[@]+"${pyargs[@]}"} \
      ${reach_flags[@]+"${reach_flags[@]}"} || check_rc $?
  fi
  return $rc
}

# checks/image-check/* boot a GCE VM in your project, so they are gated as mutating.
# run_in_image.sh --dry-run only assembles and validates the startup script.
cmd_check_image() {
  stamp
  tool="${1:-}"; shift || true
  case "$tool" in
    run_in_image|svshell_image_check|jar_flag_probe) script="checks/image-check/$tool.sh";;
    '') die "check image: name one of run_in_image | svshell_image_check | jar_flag_probe";;
    *)  die "check image: '$tool' is not an image check (run_in_image | svshell_image_check | jar_flag_probe; each boots a VM in your project — docs/static-checks.md)";;
  esac
  has_flag --confirm "$@" && CONFIRM=1
  # Only run_in_image implements --dry-run; the other two launchers reject it, so only that one gets
  # the plan-only exemption.
  plan_only=0
  case "$tool" in
    run_in_image) has_flag --dry-run "$@" && plan_only=1 ;;
  esac
  if [ "$plan_only" -eq 1 ]; then
    printf 'plan-only mode (--dry-run, implemented by run_in_image): no VM will exist.\n'
  else
    if read_only_on; then
      refuse_readonly "check image $tool" "bash $script $*" \
        "It boots a GCE VM in your project: compute, not a check."
    fi
    need_confirm "check image $tool" "boots a GCE VM in your project"
    announce_write "a temporary GCE VM that pulls the image and runs your probe in it" \
      "project $(cfg PROJECT), zone $(cfg ZONE), machine $(cfg MACHINE_TYPE); the image tested is the ref you pass with --image" \
      "one VM for the probe's runtime, capped by the script's own timeout ceiling; VM-minutes only — this repo quotes no prices, multiply by your own rate" \
      "the script deletes the instance when it finishes; --keep leaves it up, and gcloud compute instances delete <name> --zone <zone> is the undo"
  fi
  # --confirm is consumed here; these launchers reject unknown flags.
  strip_confirm "$@"
  cd "$ROOT" || die "cd failed"
  exec bash "$script" ${STRIPPED[@]+"${STRIPPED[@]}"}
}

# ------------------------------------------------------------------ build
# The default is the free preview (--check, then --dry-run). The real build boots a VM and pushes,
# so it needs --confirm; gatk-sv-build.sh has no prompt of its own (docs/docker-builds.md).
cmd_build() {
  stamp
  branch=""; fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) CONFIRM=1; shift;;      # the only flag this subcommand owns
      -*)       die "build: $1 is a docker/gatk-sv-build.sh flag, not a gsvtk one. This subcommand
takes the branch, optional image targets, and --confirm -- nothing else, because the two free
previews it would select (--check, --dry-run) are exactly what \`gsvtk build <branch>\` already
runs. Anything past that belongs to the script:
         cd $ROOT && docker/gatk-sv-build.sh $1 ${branch:-<branch>}";;
      *)        fwd+=("$1"); shift;;
    esac
  done
  # First positional is the branch; the rest are image targets, forwarded verbatim.
  rest=(); i=0
  for a in ${fwd[@]+"${fwd[@]}"}; do
    if [ "$i" = 0 ] && [ -z "$branch" ]; then branch="$a"; else rest+=("$a"); fi
    i=$((i + 1))
  done
  [ -n "$branch" ] || die "build: no branch named (usage: gsvtk build <branch> [image ...] [--confirm])"

  cd "$ROOT" || die "cd failed"
  if [ "$CONFIRM" != 1 ]; then
    # Preview: --check, then --dry-run.
    printf '=== --check (read-only preflight) ===\n'
    bash docker/gatk-sv-build.sh --check "$branch" ${rest[@]+"${rest[@]}"} \
      || die "preflight failed; fix that before anything else"
    printf '\n=== --dry-run (prints the gcloud command, creates nothing) ===\n'
    bash docker/gatk-sv-build.sh --dry-run "$branch" ${rest[@]+"${rest[@]}"}
    printf '\nReal build (starts a VM now): gsvtk build %s --confirm\n' "$branch"
    printf '  or in the checkout:          docker/gatk-sv-build.sh %s\n' "$branch"
    return 0
  fi

  if read_only_on; then
    refuse_readonly "build $branch" "docker/gatk-sv-build.sh $branch $(join ${rest[@]+"${rest[@]}"})" \
      "It boots a VM, builds, and pushes images: compute plus a registry write."
  fi
  need_confirm "build $branch" "boots a VM, builds images and pushes them to your registry"
  announce_write "one builder VM, a docker build, and a push of the images it built" \
    "images land in $(cfg IMAGE_REPO) (key IMAGE_REPO; the guard-rail namespace is $(cfg IMAGE_NAMESPACE) — do not push where a production pipeline reads from); the VM runs in project $(cfg PROJECT), zone $(cfg ZONE)" \
    "one $(cfg MACHINE_TYPE) VM with a $(cfg DISK_GB) GB disk for 1.5-3 h (timeout ceiling 8 h); gatk-sv images are linux/amd64, so they cannot be built on your laptop instead. VM-minutes only: this repo quotes no prices" \
    "the VM is deleted on exit (--keep leaves it up, gcloud compute instances delete is the undo); the pushed images stay in the registry until you delete them, and nothing reads them unless a run names that tag"
  exec bash docker/gatk-sv-build.sh "$branch" ${rest[@]+"${rest[@]}"}
}

# ------------------------------------------------------------------ terra
# Read-only Terra modes dispatch freely; modes that POST, start compute or bulk-download need
# --confirm and are refused under read-only. Ambiguous verbs need a prefix: `create` exists in both
# batch_configs.py and batch_rerun_step.py, so use `configs-create` or `rerun-create`.
cmd_terra() {
  what="${1:-}"; shift || true
  # The whitelist is checked before the interpreter, so a refusal never looks like a broken
  # environment. scripts/check_skill.py parses this list.
  case "$what" in
    recon|show|check|plan|verify|status|cost|peek|inputs|save-metadata|rerun-show|dump-configs|method-plan) ;;
    *)  terra_mutating_or_refuse "$what" "$@" ;;
  esac
  p="$(py_for terra)" || die "no interpreter with firecloud: cd $ROOT && make setup, or export GSVTK_TERRA_PY=<python with firecloud>"
  stamp
  cd "$ROOT" || die "cd failed"
  case "$what" in
    recon)     exec "$p" terra/recon.py "$@";;
    show)      exec "$p" terra/batch_configs.py show "$@";;
    # Offline: binding keys vs the WDL at a ref. Needs no workspace.
    check)     exec "$p" terra/batch_configs.py check "$@";;
    plan)      exec "$p" terra/batch_freeze.py plan "$@";;
    verify)    exec "$p" terra/batch_freeze.py verify "$@";;
    status)    exec "$p" terra/batch_status.py "$@";;
    cost)      exec "$p" terra/batch_cost.py "$@";;
    inputs)    exec "$p" terra/batch_check_inputs.py "$@";;
    peek)      exec "$p" terra/batch_peek.py "$@";;
    save-metadata) exec "$p" terra/batch_save_metadata.py "$@";;
    # Mode first: batch_rerun_step.py reads argv[0] to decide whether --image is required.
    rerun-show) exec "$p" terra/batch_rerun_step.py show "$@";;
    # Read-only: every method config in a workspace, saved to one JSON for `gsvtk entity --against-dump`.
    dump-configs) exec "$p" terra/dump_configs.py "$@";;
    # Free: flatten <Workflow> at --ref and print the method-repository upload it would make.
    method-plan) [ $# -ge 1 ] || die "terra method-plan needs a workflow name (e.g. GenotypeBatch)"
                 wf="$1"; shift; exec "$p" terra/method_upload.py "$wf" plan "$@";;
  esac
}

# Mutating modes, kept out of cmd_terra so its whitelist stays the single list check_skill.py parses.
terra_mutating_or_refuse() {
  what="${1:-(empty)}"; shift || true
  # --confirm belongs to this gate; it is forwarded only to tools that document it.
  has_flag --confirm "$@" && CONFIRM=1
  tool=""; mode=""; own_confirm=0; py=1
  case "$what" in
    configs-create)     tool=terra/batch_configs.py;   mode=create;   own_confirm=1;;
    configs-validate)   tool=terra/batch_configs.py;   mode=validate;;
    freeze-copy|copy)   tool=terra/batch_freeze.py;    mode=copy;;
    freeze-attrs|attrs) tool=terra/batch_freeze.py;    mode=attrs;;
    rerun-create)       tool=terra/batch_rerun_step.py; mode=create;   own_confirm=1;;
    rerun-validate)     tool=terra/batch_rerun_step.py; mode=validate;;
    rerun-submit|submit) tool=terra/batch_rerun_step.py; mode=submit;  own_confirm=1;;
    # Stops a submission. abort_submission has no confirmation of its own besides --confirm.
    abort)              tool=terra/abort_submission.py; mode="";      own_confirm=1;;
    create|validate)
      # Ambiguous between two tools that POST different configs; refuse either way.
      if read_only_on; then
        refuse_readonly "terra $what" "python terra/batch_configs.py $what --confirm" \
          "It POSTs into Terra. The bare name is ambiguous besides: configs-$what is every shipped config, rerun-$what is one step's — name which tool POSTs."
      fi
      printf 'gsvtk: refusing "%s" — the name is ambiguous and this CLI will not pick which tool POSTs.\n' \
        "$what" >&2
      printf '       configs-%s   → terra/batch_configs.py      (every shipped method config)\n' "$what" >&2
      printf '       rerun-%s     → terra/batch_rerun_step.py   (one step, images pinned in the body)\n' "$what" >&2
      printf '       Name one, and add --confirm.\n' >&2
      exit 2;;
    # Workflow name comes before the mode on this tool's command line; see the exec below.
    method-upload)  tool=terra/method_upload.py;        mode=""; own_confirm=1;;
    fetch)          tool=terra/fetch_outputs.py;        mode="";;
    fetch-compare)  tool=terra/batch_fetch_compare.sh;  mode=""; py=0;;
    *)  terra_usage_refuse "$what" ;;
  esac

  # Plan-only is decided by mode, for flags the tool actually implements: fetch_outputs.py --dry-run
  # (prints the plan) and --verify (re-hashes local files), and `fetch-compare table` (local diff).
  # Every other mode here POSTs, boots or uploads and goes through both gates, whatever flags it gets.
  plan_only=0
  case "$what" in
    fetch)          { has_flag --dry-run "$@" || has_flag --verify "$@"; } && plan_only=1 ;;
    fetch-compare)  [ "${1:-}" = "table" ] && plan_only=1 ;;   # local diff of already-fetched files
  esac

  shown="$tool${mode:+ $mode}"
  if read_only_on && [ "$plan_only" != 1 ]; then
    refuse_readonly "terra $what" "python $shown $*" "$(terra_detail "$what")"
  fi
  if [ "$plan_only" != 1 ]; then
    need_confirm "terra $what" "$(terra_detail "$what")"
    announce_write "$(terra_what "$what")" "$(terra_where "$what")" \
      "$(terra_cost "$what")" "$(terra_undo "$what")"
  fi

  if [ "$py" = 1 ]; then
    p="$(py_for terra)" || die "no interpreter with firecloud: cd $ROOT && make setup, or export GSVTK_TERRA_PY=<python with firecloud>"
  fi
  stamp
  cd "$ROOT" || die "cd failed"
  # --confirm is forwarded only to tools that document it. Tools gated on --write still need --write.
  if [ "$own_confirm" != 1 ]; then strip_confirm "$@"; else STRIPPED=("$@"); fi
  if [ "$what" = method-upload ]; then
    [ ${#STRIPPED[@]} -ge 1 ] || die "terra method-upload needs a workflow name (e.g. GenotypeBatch)"
    exec "$p" "$tool" "${STRIPPED[0]}" upload "${STRIPPED[@]:1}"
  fi
  if [ "$py" = 1 ]; then
    if [ -n "$mode" ]; then exec "$p" "$tool" "$mode" ${STRIPPED[@]+"${STRIPPED[@]}"}; fi
    exec "$p" "$tool" ${STRIPPED[@]+"${STRIPPED[@]}"}
  fi
  if [ -n "$mode" ]; then exec bash "$tool" "$mode" ${STRIPPED[@]+"${STRIPPED[@]}"}; fi
  exec bash "$tool" ${STRIPPED[@]+"${STRIPPED[@]}"}
}

# Unknown mode: print both mode lists and exit 2.
terra_usage_refuse() {
  local what="$1"
  [ "$what" = "(empty)" ] && \
    printf 'gsvtk: refusing "(empty)" — no Terra mode was given.\n' >&2 || \
    printf 'gsvtk: refusing "%s" — not a mode this CLI dispatches.\n' "$what" >&2
  printf '  read-only modes (dispatch freely):
    recon | show | check | plan | verify | status | cost | peek | inputs | save-metadata |
    rerun-show | dump-configs | method-plan
  mutating modes (need --confirm; refused outright under GSVTK_READ_ONLY=1 / --read-only):
    configs-create | configs-validate | freeze-copy | freeze-attrs | rerun-create |
    rerun-validate | rerun-submit | abort | fetch | fetch-compare | method-upload
  Bare create / validate are refused as AMBIGUOUS (they belong to two tools); bare copy, submit
  and attrs are unambiguous aliases of freeze-copy, rerun-submit and freeze-attrs.

  Each mode forwards its own flags verbatim: --against, --image KEY=REF, --write,
  --allow-shared-target, --dry-run, ... Nothing here adds a flag to a tool or drops one.

  `profile` and a bare `attrs` are refused as a CLASS even though the tool behind them can print
  without writing: they are the publishing path, and an outer gate does not grade a publishing
  tool by which flag it happened to be handed. Run them in the checkout if that is what you want:
    cd %s && python terra/batch_freeze.py attrs        (no --write: prints only)\n' "$ROOT" >&2
  exit 2
}

# One sentence per mode, shared by the refusal and the pre-flight.
terra_detail() {
  case "$1" in
    configs-create)   printf 'POSTs method configs into your Terra workspace, overwriting the bodies a submission will read';;
    configs-validate) printf 'asks Terra to resolve each config against its Dockstore WDL — a live Terra round trip, so the ref it grades is Terra'"'"'s, not your checkout'"'"'s';;
    freeze-copy|copy) printf 'server-side copies tens of GiB of baseline inputs into your sandbox bucket';;
    freeze-attrs|attrs) printf 'writes *<frozen suffix> entity attributes onto the module'"'"'s baseline row in Terra (the batch sample_set for genotyping)';;
    rerun-create)     printf 'POSTs a one-step rerun config into your Terra workspace';;
    rerun-validate)   printf 'asks Terra to typecheck the rerun config — a live Terra round trip';;
    rerun-submit|submit) printf 'starts a submission: a batch of VMs, real money';;
    abort)          printf 'DELETEs one running submission in Terra: it stops a run in flight, and Terra keeps the objects that step already wrote';;
    method-upload)    printf 'uploads a flattened WDL into Terra'"'"'s method repository as a new snapshot under your namespace';;
    fetch)            printf 'bulk-downloads a run'"'"'s outputs into $GSVTK_WORK';;
    fetch-compare)    printf 'bulk-downloads a run'"'"'s outputs, then runs the profile/table comparison locally';;
    *)                printf 'writes or spends';;
  esac
}

terra_what() {
  case "$1" in
    configs-create)   printf 'the shipped method configs, POSTed into Terra (overwrite, not append)';;
    configs-validate) printf 'a Terra-side typecheck of each config against its published WDL';;
    freeze-copy|copy) printf 'server-side GCS->GCS copies of every frozen baseline input';;
    freeze-attrs|attrs) printf 'a new attribute column set on the module'"'"'s baseline row in Terra';;
    rerun-create)     printf 'one rerun method config, with the image refs pinned into its body';;
    rerun-validate)   printf 'a Terra-side typecheck of the rerun config';;
    rerun-submit|submit) printf 'one Terra submission: a fleet of VMs for the step';;
    abort)          printf 'one running Terra submission stopped mid-flight (its remaining VM work is cancelled)';;
    method-upload)    printf 'one new method snapshot (agora://<namespace>/<name>/<N>) holding the branch WDL and its commit';;
    fetch)            printf 'a local copy of the run'"'"'s declared outputs, plus a sha256 manifest';;
    fetch-compare)    printf 'a local copy of the chain outputs, then gatk-sv-profile and compare/ locally';;
  esac
}

terra_where() {
  case "$1" in
    configs-create|configs-validate|freeze-attrs|attrs|rerun-create|rerun-validate|rerun-submit|submit|abort)
      printf 'Terra %s — the tools refuse the SHARED baseline workspace unless --allow-shared-target' "$(ws_target)";;
    freeze-copy|copy)
      printf 'the sandbox bucket of %s (its bucketName); the manifest that records it goes under %s/manifests' "$(ws_target)" "$(cfg WORK)";;
    fetch|fetch-compare)
      printf '%s (GSVTK_WORK): outputs/, manifests/, and the compare tree' "$(cfg WORK)";;
    method-upload)
      printf 'Terra method repository, namespace %s (the tool refuses the shared baseline namespace unless --allow-shared-target)' "$(cfg TERRA_NAMESPACE)";;
  esac
}

terra_cost() {
  case "$1" in
    configs-create|configs-validate|rerun-create|rerun-validate)
      printf 'no VM cost; the cost is a config a later submission silently reads, and Terra keeps no history of the body it replaced';;
    freeze-copy|copy)
      printf 'billable GCS objects — tens of GiB — in your sandbox bucket; the copy is server-side (no egress), and nothing overwrites them';;
    freeze-attrs|attrs)
      printf 'no money; Terra MERGES entity attributes, so a published value is not reverted by writing again';;
    rerun-submit|submit)
      printf 'a batch of VMs, tens of minutes to a few hours: VM-minutes and job counts, never a price from here. gsvtk terra cost on a finished run prints its real minutes';;
    abort)
      printf 'it stops spend rather than adding any: the VMs already running are billed for the time they ran, and this cancels the rest of the DAG. gsvtk terra cost on the aborted run prints what it cost';;
    fetch|fetch-compare)
      printf 'no Terra cost; tens of GB onto your disk, plus local CPU for the profile run';;
    method-upload)
      printf 'no money; a method snapshot other workspaces can reference until it is deleted';;
  esac
}

terra_undo() {
  case "$1" in
    configs-create|rerun-create)
      printf 'there is no undo in Terra: print the current bodies FIRST (gsvtk terra show / gsvtk terra rerun-show) and re-POST those, or recreate from the branch you meant';;
    configs-validate|rerun-validate)
      printf 'nothing to undo — it is a read request; --confirm is because it leaves this machine and grades Terra'"'"'s ref, not yours';;
    freeze-copy|copy)
      printf 'gsutil -m rm -r the copied prefix (nothing here deletes); the manifest records what was copied';;
    freeze-attrs|attrs)
      printf 'delete or republish the attribute column in the workspace data table; a merged attribute cannot be rolled back';;
    rerun-submit|submit)
      printf 'gsvtk terra abort --submission <full submission id> --confirm stops it from the client (no browser; the full id is printed by gsvtk terra recon), then gsvtk terra status --wait <config-prefix> watches it reach terminal; objects it already wrote stay in the bucket';;
    abort)
      printf 'an aborted submission does not restart: the undo is a NEW submission (gsvtk terra rerun-submit --confirm), and the objects the aborted run already wrote stay in the bucket';;
    fetch|fetch-compare)
      printf 'rm -rf the fetched tree under %s; --dry-run first prints the plan and touches nothing' "$(cfg WORK)";;
    method-upload)
      printf 'the tool prints the DELETE for the snapshot it created; gsvtk terra method-plan first shows the exact request and touches nothing';;
  esac
}

# ------------------------------------------------------------------ compare
# Comparators by file stem, arguments forwarded verbatim. Hyphens are accepted for underscores
# (`gsvtk compare table-diff` -> compare/table_diff.py).
cmd_compare() {
  name="${1:-}"; shift || true
  case "$name" in
    -h|--help|help) print_compare_usage; exit 0;;
    '') print_compare_usage >&2; exit 2;;
    --list) list_comparators; exit 0;;
  esac
  case "$name" in
    artifact) die "compare: artifact.py is the shared reader module, not a comparator — its CLI is artifact_tally.py";;
    make_fixtures) die "compare: make_fixtures.py builds the gate's test fixtures; run it directly (it is not a comparator)";;
  esac
  target="$ROOT/compare/$name.py"
  [ -f "$target" ] || target="$ROOT/compare/$(printf '%s' "$name" | tr '-' '_').py"
  [ -f "$target" ] || die "compare: no comparator '$name'. Run: gsvtk compare --list"
  stamp
  cd "$ROOT" || die "cd failed"
  exec "$PY" "$target" "$@"
}

list_comparators() {
  printf '%s\n' 'compare/ CLIs, by the name `gsvtk compare` takes (each also has --help):'
  for f in "$ROOT"/compare/*.py; do
    n="$(basename "$f" .py)"
    case "$n" in artifact|make_fixtures) continue;; esac
    printf '  %-24s compare/%s.py\n' "$n" "$n"
  done
}

print_compare_usage() {
  cat <<'USAGE'
gsvtk compare <name> [args...] — the comparators, arguments forwarded verbatim

  batch-tables / compare_batch_tables   summary tables from two runs, column by column
  table-diff                            any two tables that share a key column
  matrix-diff                           site-by-sample matrices: which cells changed
  vcf-paired-diff                       per-(site, sample) values across two VCFs
  site-set-diff                         variants found in one run but not the other
  lineset-diff                          two lists: what was added, what was removed
  json-diff                             nested JSON, with paths you choose to ignore
  tar-manifest                          two archives, by file list and checksum
  profile-summarize                     one headline number from gatk-sv-profile's own output
  pair-level-concordance                concordance between two call sets, independently
  gq-scale-compare                      whether two quality columns use the same scale
  artifact-tally                        what an output file actually contains, ignoring its
                                        own summary
  vcf-body-diff                         two VCFs' RECORD BODIES, header lines put aside
  gd-calls-diff                         two GD calls tables on (sample, GD_ID): which kind of
                                        call changed, case sample and panel counted apart
  sample-census                         how many distinct samples one evidence table holds,
                                        streamed, so a 1.8 GB matrix is censusable

`gsvtk compare --list` prints the name each one dispatches to. A comparator with nothing to compare
exits nonzero and says so: it will not report agreement on nothing (docs/comparators.md).
USAGE
}

# ------------------------------------------------------------------ replay
# build_inputs plus the drivers in examples/, and a preflight that reports missing dependencies
# (jar, JDK 17, bcftools, disk) before a long run fails.
cmd_replay() {
  mode="${1:-}"; shift || true
  case "$mode" in
    -h|--help|help) print_replay_usage; exit 0;;
    '') print_replay_usage >&2; exit 2;;
    preflight) replay_preflight "${1:-train-chr20}"; exit 0;;
    inputs)
      stamp; cd "$ROOT" || die "cd failed"
      exec "$PY" replay/build_inputs.py "$@";;
    het-population)
      stamp; cd "$ROOT" || die "cd failed"
      exec "$PY" examples/recompute_het_population.py "$@";;
    reference-run)
      replay_preflight reference-run
      stamp; cd "$ROOT" || die "cd failed"
      exec bash examples/replay_reference_run.sh "$@";;
    train-chr20|train-full|train-definitive|rd-population-probe)
      replay_preflight "$mode"
      stamp; cd "$ROOT" || die "cd failed"
      case "$mode" in
        train-chr20) exec bash examples/run_train_chr20.sh "$@";;
        train-full) exec bash examples/run_train_full.sh "$@";;
        train-definitive) exec bash examples/run_train_definitive.sh "$@";;
        rd-population-probe) exec bash examples/run_rd_population_probe.sh "$@";;
      esac;;
    task|svshell)
      # Free plan by default; --confirm boots a VM, so it gets both outer gates and is passed through.
      tool=replay/task_replay.py; [ "$mode" = svshell ] && tool=replay/svshell_run.py
      if has_flag --confirm "$@"; then
        if read_only_on; then
          refuse_readonly "replay $mode" "python $tool $*" "boots a GCE VM and runs the stage on it"
        fi
        CONFIRM=1
        need_confirm "replay $mode" "boots a GCE VM and runs the stage on it"
      fi
      stamp; cd "$ROOT" || die "cd failed"
      exec "$PY" "$tool" "$@";;
    *) die "replay: no such mode '$mode'. Run: gsvtk replay --help";;
  esac
}

print_replay_usage() {
  cat <<'USAGE'
gsvtk replay <mode> [args...] — run a real stage locally, on a captured run's exact inputs

  preflight [mode]      what blocks the replay loop here (java, jar, bcftools, disk)
  inputs                replay/build_inputs.py: rebuild a launchable inputs JSON from
                        captured Cromwell metadata
  train-chr20           examples/run_train_chr20.sh       (fast loop; RD numbers from a slice
                        belong to no real cohort)
  train-full            examples/run_train_full.sh        (the run whose RD cutoffs you quote)
  train-definitive      examples/run_train_definitive.sh  (full intervals, RD heap sized)
  rd-population-probe   examples/run_rd_population_probe.sh (cutoff behaviour, measured)
  reference-run         examples/replay_reference_run.sh  (replay one captured task command;
                        needs CAPTURED=<that task's Cromwell script> and IMAGES=<image map>)
  het-population        examples/recompute_het_population.py (population stats, recomputed
                        outside the pipeline)
  task                  replay/task_replay.py: one finished WDL task, rerun in an image on a VM
                        (free plan by default; --confirm boots the VM)
  svshell               replay/svshell_run.py: sv-shell's single_sample_pipeline.sh end to end in
                        an image on a VM, then a VCF compare (free plan; --confirm runs it)

The drivers are recipes, not supported interfaces (examples/README.md): read one, copy it, change the
step. Local replay costs time and disk, nothing else. It needs a JDK 17+ and a locally built GATK
jar — `gsvtk replay preflight` says which one you are missing and how to build it.
USAGE
}

# java_major — major version of `java` on PATH, or nothing if unreadable. Handles the old 1.x scheme.
java_major() {
  local ver major
  command -v java >/dev/null 2>&1 || return 1
  # The version is the quoted token on the first stderr line. awk, because BSD sed lacks `\?`.
  ver="$(java -version 2>&1 | head -1 | awk -F'"' 'NF>1 {print $2; exit}')"
  [ -n "$ver" ] || return 1
  major="${ver%%.*}"
  case "$major" in ''|*[!0-9]*) return 1;; esac
  if [ "$major" = 1 ]; then                       # the old scheme: 1.8.0_292 means 8
    major="$(printf '%s' "$ver" | cut -d. -f2)"
    case "$major" in ''|*[!0-9]*) return 1;; esac
  fi
  printf '%s' "$major"
}

# replay_preflight MODE — blockers exit 3 (missing dependency) with the fix. Disk space is advisory.
replay_preflight() {
  replay_preflight_report "$1" || exit 3
}

replay_preflight_report() {
  local mode="$1" blockers="" jmajor="" jar="" ck free gb w base same
  local want_java=0 want_bcftools=0
  case "$mode" in
    train-chr20|train-full|train-definitive|het-population) want_java=1; want_bcftools=1;;
    rd-population-probe) want_java=1;;
    reference-run) want_java=0;;
    *) want_java=1; want_bcftools=1;;
  esac
  printf 'replay preflight (%s)\n' "$mode"
  if [ "$want_java" = 1 ]; then
    if ! command -v java >/dev/null 2>&1; then
      printf '  java     MISSING — the trainers are Java; install a JDK 17+ (docs/local-replay.md)\n'
      blockers="$blockers java"
    else
      jmajor="$(java_major)" || jmajor=""
      if [ -z "$jmajor" ]; then
        printf '  java     present (%s) — version unreadable, so this is NOT verified\n' \
          "$(java -version 2>&1 | head -1)"
      elif [ "$jmajor" -lt 17 ]; then
        printf '  java     %s — TOO OLD: gatk needs JDK 17+ (a jar built under 8 fails later, not now)\n' \
          "$jmajor"
        blockers="$blockers java-under-17"
      else
        printf '  java     ok (major %s)\n' "$jmajor"
      fi
    fi
    ck="${GSVTK_GATK_CHECKOUT:-}"
    [ -n "$ck" ] || ck="$(cfg GATK_CHECKOUT)"
    jar="${JAR:-}"
    if [ -n "$jar" ] && [ ! -f "$jar" ]; then
      printf '  jar      JAR=%s does not exist\n' "$jar"; blockers="$blockers jar-missing"
    elif [ -n "$jar" ] && [ ! -s "$jar" ]; then
      printf '  jar      JAR=%s is 0 bytes — an rc from nothing is not a result\n' "$jar"
      blockers="$blockers jar-empty"
    elif [ -n "$jar" ]; then
      printf '  jar      ok (%s, named by JAR)\n' "$jar"
    elif [ -z "$ck" ]; then
      printf '  jar      NOT DISCOVERABLE — GSVTK_GATK_CHECKOUT is unset, so there is nowhere to look.\n'
      printf '             build one:  cd <gatk checkout> && JAVA_HOME=<JDK 17> ./gradlew localJar\n'
      printf '             then:       export GSVTK_GATK_CHECKOUT=<that checkout>\n'
      printf '             (the -local.jar is the shaded one carrying the `sv` command group; the plain\n'
      printf '             jar will not run the trainers — docs/local-replay.md)\n'
      blockers="$blockers no-jar"
    else
      jar="$(ls -t "$ck"/build/libs/gatk-package-*-local.jar 2>/dev/null | head -1)"
      if [ -z "$jar" ]; then
        printf '  jar      NOT FOUND under %s/build/libs (pattern gatk-package-*-local.jar)\n' "$ck"
        printf '             build it with JAVA_HOME=<JDK 17> ./gradlew localJar, or point JAR at it\n'
        blockers="$blockers no-jar"
      elif [ ! -s "$jar" ]; then
        printf '  jar      %s is 0 bytes — an rc from nothing is not a result\n' "$jar"
        blockers="$blockers jar-empty"
      else
        printf '  jar      ok (%s — check its build date is AFTER your change)\n' "$jar"
      fi
    fi
  fi
  if [ "$want_bcftools" = 1 ]; then
    if command -v bcftools >/dev/null 2>&1; then printf '  bcftools ok\n'
    else printf '  bcftools MISSING — the drivers slice VCFs with it (conda install -c bioconda bcftools)\n'
      blockers="$blockers bcftools"; fi
  fi
  if [ "$mode" = "reference-run" ]; then
    if [ -z "${CAPTURED:-}" ] || [ ! -f "${CAPTURED:-}" ]; then
      printf '  CAPTURED unset or not a file — that driver replays a LOCAL copy of one task'"'"'s\n'
      printf '             Cromwell `script` (the gsutil cp is in the script'"'"'s own header). There is\n'
      printf '             no live-workspace mode, which is what keeps it offline.\n'
      blockers="$blockers CAPTURED"
    else printf '  captured ok (%s)\n' "$CAPTURED"; fi
    if [ -z "${IMAGES:-}" ] || [ ! -f "${IMAGES:-}" ]; then
      printf '  IMAGES     unset or not a file — the per-arm image map (replay/images.example.json)\n'
      blockers="$blockers IMAGES"
    else printf '  images     ok (%s)\n' "$IMAGES"; fi
  fi
  # Disk is reported, not enforced: docs/local-replay.md budgets "tens of GB", a single region far less.
  w="$(cfg WORK)"
  if [ -n "$w" ]; then
    # GSVTK_WORK may not exist yet; measure the nearest existing parent.
    base="$w"
    while [ ! -d "$base" ] && [ "$base" != "/" ]; do base="$(dirname "$base")"; done
    same=1; [ "$base" = "$w" ] || same=0
    free="$(df -k "$base" 2>/dev/null | awk 'NR==2 {print $4}')"
    if [ -n "$free" ]; then
      gb=$((free / 1048576))
      if [ "$same" = 1 ]; then printf '  disk     %s GB free at %s\n' "$gb" "$w"
      else printf '  disk     %s GB free at %s (%s does not exist yet)\n' "$gb" "$base" "$w"; fi
      if [ "$gb" -lt 40 ]; then
        printf '           below the "tens of GB" budget docs/local-replay.md budgets: if staging stops\n'
        printf '           short, this is why. Point GSVTK_WORK at a roomier disk, stage one region\n'
        printf '           (--region chr20), or hardlink a panel you already hold (--link-dir).\n'
      fi
    else
      printf '  disk     df reported nothing for %s\n' "$base"
    fi
  fi
  if [ -n "$blockers" ]; then
    printf 'preflight: BLOCKED by%s\n' "$blockers"
    printf '           exit 3 = a missing dependency, named above. Nothing was run.\n'
    return 1
  fi
  printf 'preflight: ok\n'
  return 0
}

# ------------------------------------------------------------------ usage
usage() {
  cat <<'USAGE'
gsvtk <command> — the gatk-sv-testkit command line

  locate                    this checkout, its git state, which tools are present
  doctor [--redact]         what is configured / missing (values hidden with --redact)
  tools                     which of the four loops can run on this machine right now
  check [<ref>] [--wf NAME]... [--strict] [--repo DIR] [--compare-to REF] [--semantics] [--reach]
            (--reach answers a reach question about a NAMED workflow, so it needs --wf NAME; the tree
             it scans defaults to GSVTK_GATK_SV_CHECKOUT, and so does --semantics)
                            the static checks (WDL launchability, sv_shell JSON contract,
                            jq plumbing; --semantics/--reach add the two tree-wide checkers)
  check image <run_in_image|svshell_image_check|jar_flag_probe> ...
                            ask a PUBLISHED image a question — boots a VM, so --dry-run is free
                            and the real probe needs --confirm
  entity [--ref REV | --tree DIR] [--corpus PATH]
                            which entity row each launch config runs against
                            (checks/terra_entity_check.py): the type derived from the config's own
                            ${this.<etype>_id}, cross-checked against the entity tables that ref ships,
                            plus a census of what the tool did NOT check. Read-only either way — it reads
                            a ref with `git archive` or a directory you name, never a workspace
  publish [--from-file CAPTURE] [--step NN | --all-steps] [--entry E --version V] [--branch B]
          [--tip SHA | --tip-from-file FILE | --ls-remote] [--fetch]
                            is the Dockstore version a rerun names still the branch tip? One tool
                            (checks/version_resolves.py), two depths: the name resolves, and the commit
                            behind it. Reads a capture you made; fetches only if you pass --ls-remote
                            (one read-only `git ls-remote`), and writes nothing anywhere, so it runs
                            under GSVTK_READ_ONLY=1 with no --confirm
  publish-check <branch>    the same check with the live defaults filled in: --fetch (one unauthenticated GET
                            per entry) plus --ls-remote for the tip. Both are GETs: nothing POSTed, nothing
                            written, so it too runs under GSVTK_READ_ONLY=1 with no --confirm
  build <branch> [image ...] [--confirm]
                            no flags but --confirm: the default IS the free preview (--check then
                            --dry-run); --confirm does the real build. Other gatk-sv-build.sh flags
                            belong to the script, which names them in its own --help
  terra <mode>              read-only: recon | show | check | plan | verify | status | cost |
                            peek | inputs | save-metadata | rerun-show | dump-configs | method-plan
                            write or spend (need --confirm): configs-create | configs-validate |
                            freeze-copy | freeze-attrs | rerun-create | rerun-validate |
                            rerun-submit | abort | fetch | fetch-compare | method-upload
                            abort --submission <full id> --confirm stops a running submission from the
                            client (the full id is printed by `gsvtk terra recon`); it then reports the
                            terminal state it observed, or says it observed none (--no-wait)
  compare <name> [args...]  the comparators, dispatched by name, args verbatim (--list for names)
  replay <mode> [args...]   inputs | train-chr20 | train-full | train-definitive |
                            rd-population-probe | reference-run | het-population | preflight |
                            task | svshell   (these two plan for free; --confirm boots a VM)
  compat [check|table|note] [--ref REF] [--role branch|baseline] [--record]
                            is this kit compatible with a gatk-sv ref (scripts/check_compat.py)?
                            check (the default) reads your gatk-sv clone with git only; --record
                            writes the result to compat.json, the list of checked refs
  repo                      print this checkout's path only
  version                   which checkout this is

Global flags, before the command:
  --read-only               same as GSVTK_READ_ONLY=1: refuse every mode that POSTs, boots compute
                            or bulk-downloads, and do it BEFORE any dependency or config check
  --module NAME             which module the dispatched tool drives: exports GSVTK_MODULE (the env tier
                            of the one resolver; this program never reads it), and NAME is the profile
                            file, so single_sample is profiles/single_sample.json. Default: the
                            resolved MODULE, which ships as genotyping. It changes which STEP numbers
                            exist — the step map comes from the profile — so a step outside the default
                            map is refused by name without this flag: --module single_sample terra
                            rerun-show --step 01 prints the body of the single-sample step, which the
                            shipped genotyping map answers with "unknown step '01'". Launching such a
                            module is gated like any other rerun: no --image ref and no --entity row is
                            a refusal, not a default (docs/cli.md, docs/test-a-branch.md)
  --confirm                 after the command: the outer gate for a mutating mode. A tool's own
                            --confirm / --write / --allow-shared-target still has to be typed too

Every tool is still a script you can run directly, and each tool's own --help stays the authority on
its flags. docs/cli.md is the command-to-tool map and the read-only contract; README's tool reference
lists the scripts. Exit codes: 0 clean, 1 findings or failure, 2 usage / refused, 3 missing
dependency, 4 missing required config.
USAGE
}

# ---------------- entity: which entity row a launch config runs against
# Dispatches checks/terra_entity_check.py. Read-only (reads a git ref or a directory, never a
# workspace), so it takes no --confirm.
cmd_entity() {
  local ref="" tree="" repo="" corpus="" dump="" pyargs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        printf '%s\n' \
'usage: gsvtk entity [--ref REV | --tree DIR] [--corpus PATH] [-- <extra tool flags>]' \
'' \
'Which entity type each launch config in the corpus runs against, derived from the config"s own' \
'single-component name key ${this.<etype>_id}, then cross-checked against the entity/membership' \
'TSVs that same ref ships. Refuses (exit 1) rather than guessing: zero name keys, more than one,' \
'no table of the derived type, or a read that is not a column of one it found. Every run also prints' \
'GSVTK-ENTITY-UNCHECKED — what the tool deliberately did NOT evaluate (member attributes,' \
'${workspace.*} bindings, Terra"s own rootEntityType) — because "no refusal printed" and "nothing' \
'left unexamined" are different facts.' \
'Every run also prints GSVTK-ORACLE (one line per flavor) and GSVTK-ORACLE-SUMMARY: what each' \
'flavor"s own workspace.tsv.tmpl declares, since that table"s first column is the offline oracle' \
'a ${workspace.X} binding has to be found in — and which flavors ship no such table at all.' \
'' \
'  --ref REV     read a revision with git archive (default: whatever checks/terra_entity_check.py' \
'                resolves, which is GSVTK_GATK_SV_CHECKOUT via kit/gsvtk-config, then its own default)' \
'  --repo DIR    the gatk-sv checkout to read the revision from (with --ref)' \
'  --tree DIR    grade a directory you already have instead of a ref' \
'  --corpus PATH the corpus inside the tree (default inputs/templates/terra_workspaces)' \
'  --against-dump FILE  compare each config'"'"'s derived entity type with Terra'"'"'s rootEntityType, from a' \
'                saved workspace dump (gsvtk terra dump-configs); offline' \
'' \
'Exit codes are the tool"s: 0 every config answered, 1 findings, 2 usage, 3 missing prerequisite.' \
'checks/terra_entity_check.py --help stays authoritative for its own flags.'
        return 0;;
      --ref)     ref="${2:?entity --ref needs a revision (main, a branch, a sha)}"; shift 2;;
      --repo)    repo="${2:?entity --repo needs a checkout directory}"; shift 2;;
      --tree)    tree="${2:?entity --tree needs a directory}"; shift 2;;
      --corpus)  corpus="${2:?entity --corpus needs a path, e.g. inputs/templates/terra_workspaces}"; shift 2;;
      --against-dump) pyargs+=(--against-dump "${2:?entity --against-dump needs a file from gsvtk terra dump-configs}"); dump=1; shift 2;;
      --)        shift; while [ $# -gt 0 ]; do pyargs+=("$1"); shift; done;;
      -*)        die "entity: unknown flag $1 (flags: --repo DIR --ref REV --tree DIR --corpus PATH --against-dump FILE; run: gsvtk entity --help)";;
      *)         die "entity: unexpected argument '$1' — this command takes flags, not positions (run: gsvtk entity --help)";;
    esac
  done
  cd "$ROOT" || die "cd failed"
  # --tree with --ref/--repo is ambiguous; refuse rather than pick one.
  if [ -n "$tree" ] && { [ -n "$ref" ] || [ -n "$repo" ]; }; then
    die "entity: --tree already fixes the tree, so --ref/--repo would be a second answer to the same question.
  Pass one of:
    ./gsvtk entity --repo DIR --ref main   # a revision, read with git archive (read-only)
    ./gsvtk entity --tree DIR              # a checkout you already have"
  fi
  # No default tree here: the tool asks the resolver itself and reports a named exit 3 if unset.
  if   [ -n "$repo" ];   then pyargs+=(--repo "$repo"); fi
  if   [ -n "$tree" ];   then pyargs+=(--tree "$tree"); fi
  if   [ -n "$ref" ];    then pyargs+=(--ref "$ref"); fi
  if   [ -n "$corpus" ]; then pyargs+=(--corpus "$corpus"); fi
  printf '=== terra_entity_check.py — which entity row each launch config runs against ===\n'
  "$PY" checks/terra_entity_check.py ${pyargs[@]+"${pyargs[@]}"}
  local rc=$?
  if [ "$rc" = 0 ] && [ -z "$dump" ]; then
    # Exit 0 means every config was answered, not that the rows exist or the values are right.
    printf '  (exit 0 = every config ANSWERED. Not: the entity row exists, the values are right, or that\n'
    printf '   the live rootEntityType agrees. UNCHECKED above counts what was never evaluated.)\n'
  fi
  return $rc
}

# ------------------------------------------------------------------ publish
# Is the Dockstore version a rerun names still the branch tip? checks/version_resolves.py owns the
# verdicts; this handles flags and the tip/capture sources.
#
# Read-only, so it runs under GSVTK_READ_ONLY=1 with no --confirm. By default it touches no network.
# --fetch (unauthenticated Dockstore GETs) and --ls-remote (one `git ls-remote`) are opt-in reads,
# printed before they run. The offline tests use --tip-from-file.
cmd_publish() {
  local from="" step="" entry="" version="" branch="" tip="" tipfile="" ck="" want_all=0 want_ls=0 want_fetch=0 check_mode=0
  local capmk="" entfile=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        printf '%s\n' \
'usage: gsvtk publish [--from-file CAPTURE] [--step NN | --all-steps] [--entry E --version V]' \
'                     [--branch B] [--tip SHA | --tip-from-file FILE | --ls-remote]' \
'' \
'For each Dockstore entry a rerun names: is the descriptor Dockstore serves still the branch tip?' \
'' \
'One tool answers it (checks/version_resolves.py), at two depths. The NAME resolves, and the COMMIT behind it.' \
'Without a tip source you get the name answer (RESOLVES / NO SUCH ENTRY / NO SUCH VERSION). With one you get' \
'CURRENT, STALE, ABSENT or REFUSED -- and STALE names both shas, because "it is behind" is not actionable.' \
'' \
'  --from-file CAPTURE   a captured Dockstore listing. The grader itself never fetches (a check that reaches the' \
'                        network fails differently on the next machine), so this hands it a file you made.' \
'  --fetch               MAKE that file: one unauthenticated GET per entry, on the anonymous route --' \
'                        <root>workflows/path/workflow/<entry>/published?include=versions, root being' \
'                        $GSVTK_DOCKSTORE_API_ROOT (default https://dockstore.org/api/). Read-only: a GET, no token,' \
'                        nothing POSTed. This is the arm `publish-check` takes by default. If a GET fails the command' \
'                        STOPS at exit 3 naming the entry -- a capture never read is REFUSED, and grading a partial one' \
'                        would call the entry it never saw ABSENT, the one thing this check promised not to do.' \
'  --step NN | --all-steps' \
'                        which entries to ask about: one step of the module profile, or every entry a rerun can name' \
'  --entry E --version V ask about them directly instead of deriving them from the launcher' \
'  --branch B            the branch the version names; default the version name itself, which for these entries' \
'                        IS a branch name. A branch with no tip source is a REFUSAL that prints the tip command, not' \
'                        a depth-1 pass -- answering depth 1 to a depth-2 question is how a stale WDL gets an' \
'                        all-clear, which is the defect this subcommand exists to catch.' \
'  --tip SHA             the commit at refs/heads/<branch>, pasted from git ls-remote' \
'  --tip-from-file FILE  a file holding that ls-remote output (the seam the offline gate drives)' \
'  --ls-remote           read it instead: one `git ls-remote origin refs/heads/<branch>` against' \
'                        $GSVTK_GATK_SV_CHECKOUT, fed in as --tip-from-file. Read-only, and the only network this' \
'                        subcommand can make.' \
'' \
'Read-only either way: no --confirm, no Terra call, nothing launched, nothing written. On STALE or ABSENT it prints' \
'the remedy (a throwaway <branch>_terra at the tip plus the filter commit, then re-check) and runs none of it.' \
'' \
'Exit codes are the tool'"'"'s: 0 CURRENT, 1 STALE/ABSENT, 2 usage, 3 --ls-remote could not read the remote,' \
'4 REFUSED (the capture or the tip source cannot answer). checks/version_resolves.py --help is authoritative for its' \
'own flags.'
        return 0;;
      --from-file)     from="${2:?publish --from-file needs a capture file (CAPTURE in checks/version_resolves.py --help has the curl)}"; shift 2;;
      --step)          step="${2:?publish --step needs a step number}"; shift 2;;
      --entry)         entry="${2:?publish --entry needs a Dockstore entry path}"; shift 2;;
      --version)       version="${2:?publish --version needs the version name the launch carries}"; shift 2;;
      --branch)        branch="${2:?publish --branch needs a branch name}"; shift 2;;
      --tip)           tip="${2:?publish --tip needs the sha from git ls-remote}"; shift 2;;
      --tip-from-file) tipfile="${2:?publish --tip-from-file needs a file holding git ls-remote output}"; shift 2;;
      --ls-remote)     want_ls=1; shift;;
      --fetch)         want_fetch=1; shift;;
      --check)         check_mode=1; shift;;
      [!-]*)           [ -z "$branch" ] && { branch="$1"; version="$1"; }; shift;;
      --all-steps)     want_all=1; shift;;
      --)              shift; while [ $# -gt 0 ]; do pyargs+=("$1"); shift; done;;
      -*)              die "publish: unknown flag $1 (flags: --from-file CAPTURE --fetch --step NN --all-steps --entry E --version V --branch B --tip SHA --tip-from-file FILE --ls-remote; run: gsvtk publish --help)";;
    esac
  done
  cd "$ROOT" || die "cd failed"
  stamp
  [ -n "$from" ]    && pyargs+=(--from-file "$from")
  [ -n "$step" ]    && pyargs+=(--step "$step")
  [ -n "$entry" ]   && pyargs+=(--entry "$entry")
  [ -n "$version" ] && pyargs+=(--version "$version")
  [ -n "$branch" ]  && pyargs+=(--branch "$branch")
  [ -n "$tip" ]     && pyargs+=(--tip "$tip")
  [ -n "$tipfile" ] && pyargs+=(--tip-from-file "$tipfile")
  [ "$want_all" = 1 ] && pyargs+=(--all-steps)
  # Default scope is every entry a rerun can name; --step or --entry narrows it.
  if [ -z "$step" ] && [ -z "$entry" ] && [ "$want_all" != 1 ]; then
    want_all=1
    pyargs+=(--all-steps)
  fi
  # publish-check BRANCH reads both the Dockstore capture and the branch tip, unless the caller
  # supplied either source explicitly.
  if [ "$check_mode" = 1 ]; then
    [ -n "$from" ] || [ "$want_fetch" = 1 ] || want_fetch=1
    if [ -z "$tip" ] && [ -z "$tipfile" ] && [ "$want_ls" != 1 ]; then want_ls=1; fi
  fi
  # --fetch and --from-file both define the capture; refuse both together.
  if [ "$want_fetch" = 1 ] && [ -n "$from" ]; then
    die "publish: --fetch would replace the capture passed with --from-file, and a verdict is a claim about ONE document.
  Grade the file:   ./gsvtk publish --from-file <capture> ...
  Read the live one: ./gsvtk publish-check <branch>   (or publish --fetch alone)"
  fi
  # Fetch one document per entry in scope (the grader's --print-entries decides the scope) and
  # assemble them into a JSON array, a shape parse_capture accepts.
  if [ "$want_fetch" = 1 ]; then
    local root="${GSVTK_DOCKSTORE_API_ROOT:-https://dockstore.org/api/}"
    entfile="$(mktemp "${TMPDIR:-/tmp}/gsvtk-publish-ents.XXXXXX")" || die "publish: cannot make a temp file"
    capmk="$(mktemp "${TMPDIR:-/tmp}/gsvtk-publish-cap.XXXXXX")" || die "publish: cannot make a temp file"
    local -a entsel=(--print-entries)
    if [ "$want_all" = 1 ]; then entsel+=(--all-steps); else entsel+=(--step "${step:-01}"); fi
    [ -n "$entry" ] && entsel+=(--entry "$entry")
    [ -n "$version" ] && entsel+=(--version "$version")
    if ! "$PY" checks/version_resolves.py "${entsel[@]}" > "$entfile" 2>&1; then
      local ew; ew="$(head -3 "$entfile" 2>/dev/null)"; rm -f "$entfile" "$capmk"; entfile=""; capmk=""
      printf 'gsvtk: the entry list could not be derived (nothing was fetched). Its words:\n  %s\n' "${ew:-the tool said nothing}" >&2
      exit 2
    fi
    printf '[\n' > "$capmk"
    local n_done=0 sep="" body ent
    while IFS= read -r ent; do
      [ -n "$ent" ] || continue
      local enc url; enc="${ent//\//%2F}"; url="${root%/}/workflows/path/workflow/$enc/published?include=versions"
      printf 'fetch     GET %s  (unauthenticated: no token, no POST)\n' "$url" >&2
      body="$(mktemp "${TMPDIR:-/tmp}/gsvtk-publish-body.XXXXXX")"
      if ! curl -fsS --max-time 90 -o "$body" "$url" 2>/dev/null \
         || ! "$PY" -c 'import json,sys; json.load(open(sys.argv[1]))' "$body" 2>/dev/null; then
        rm -f "$body" "$entfile" "$capmk"; entfile=""; capmk=""
        printf 'gsvtk: REFUSED -- Dockstore could not be consulted for %s (nothing was compared, no verdict implied).
  This is NOT an absence answer: the entry was never read, so it cannot be called ABSENT. Grade a file you read
  yourself:  curl -fsS "%s" -o capture.json && ./gsvtk publish --from-file capture.json ...
' "$ent" "$url" >&2
        exit 3
      fi
      printf '%s  ' "$sep" >> "$capmk"; cat "$body" >> "$capmk"; rm -f "$body"
      sep=","; n_done=$((n_done + 1))
    done < "$entfile"
    printf '\n]\n' >> "$capmk"
    printf 'capture %s fetched (%s, unauthenticated)\n' "$n_done" "${root%/}" >&2
    from="$capmk"
    pyargs+=(--from-file "$capmk")
  fi
  # Only one tip source; --ls-remote with --tip/--tip-from-file is refused.
  if [ "$want_ls" = 1 ] && { [ -n "$tip" ] || [ -n "$tipfile" ]; }; then
    die "publish: --ls-remote would replace the tip you already passed, and a verdict is a claim about one comparison.
  Pass one of:
    ./gsvtk publish --ls-remote ...                      # read refs/heads/<branch> now (read-only)
    ./gsvtk publish --tip <sha> ...                      # the sha you already read
    ./gsvtk publish --tip-from-file <file> ...           # a capture of that output (what the offline gate does)"
  fi
  # Read the tip from the gatk-sv checkout's origin, not this repo's.
  if [ "$want_ls" = 1 ]; then
    local target="${branch:-$version}"
    if [ -z "$target" ]; then
      die "publish --ls-remote needs to know which branch to ask for: pass --branch NAME (or --version NAME, which is
  a branch name for these entries). Reading some ref and comparing it to your version is not a check; it is a coin
  flip that prints CURRENT."
    fi
    ck="$(cfg GATK_SV_CHECKOUT)"
    [ -n "$ck" ] || die "publish --ls-remote needs a gatk-sv checkout to ask its origin: export GSVTK_GATK_SV_CHECKOUT=<path> (that is where refs/heads/<branch> lives; this testkit's own origin does not hold gatk-sv branches). Or pass --tip / --tip-from-file and run this offline."
    [ -d "$ck" ] || die "publish --ls-remote: GSVTK_GATK_SV_CHECKOUT=$ck is not a directory (run: gsvtk doctor)"
    local tipmk
    tipmk="$(mktemp "${TMPDIR:-/tmp}/gsvtk-publish-tip.XXXXXX")" || die "publish: cannot make a temp file for the tip"
    printf 'tip       git -C %s ls-remote origin refs/heads/%s\n' "$ck" "$target" >&2
    if ! git -C "$ck" ls-remote origin "refs/heads/$target" > "$tipmk" 2>&1; then
      local why; why="$(head -3 "$tipmk" 2>/dev/null)"; rm -f "$tipmk"
      printf 'gsvtk: git ls-remote could not read refs/heads/%s (nothing was compared). Its words:\n  %s\n' \
        "$target" "${why:-git said nothing}" >&2
      exit 3
    fi
    tipfile="$tipmk"
    pyargs+=(--tip-from-file "$tipmk")
  fi
  "$PY" checks/version_resolves.py ${pyargs[@]+"${pyargs[@]}"}
  local rc=$?
  # Remove only the temp files this function created.
  [ -n "$capmk" ] && rm -f "$capmk"
  [ -n "$entfile" ] && rm -f "$entfile"
  # Test the path variable, not want_ls (which is "0", a non-empty string).
  [ -n "${tipmk:-}" ] && rm -f "$tipmk"
  if [ "$rc" = 1 ]; then
    printf '  (STALE or ABSENT: the remedy above names the throwaway branch and the filter commit. Nothing here\n'
    printf '   pushed, POSTed or launched anything, and the same command re-run after the sync is the re-check.)\n'
  fi
  return $rc
}

# compat_note — one stderr line when the gatk-sv checkout is not a commit compat.json records as
# compatible. Never fails and never blocks the command.
compat_note() { ( cd "$ROOT" && "$PY" scripts/check_compat.py note ) || true; }

# ------------------------------------------------------------------ dispatch
# Leading global flags only; a --confirm after the subcommand is handled by that subcommand's gate.
while [ $# -gt 0 ]; do
  case "$1" in
    --read-only) READ_ONLY=1; shift;;
    # Exports GSVTK_MODULE for the child tool. An empty or missing NAME is refused: it would
    # silently fall back to the default module.
    --module)
      case "${2:-}" in
        ''|-*) die "--module wants a module NAME (a profile file: $(cfg MODULE_DIR)/<NAME>.json).
  An empty or missing name is refused rather than defaulted: --module \"\${MODULE}\" with MODULE unset
  would silently select the resolved default module ($(cfg MODULE)) and launch a different module
  than the one you asked for. Run: ./gsvtk --help (or ls $(cfg MODULE_DIR))";;
      esac
      GSVTK_MODULE="$2"; export GSVTK_MODULE; shift 2;;
    *) break;;
  esac
done

# The interpreter every dispatched python tool runs under, resolved once.
PY="$(py_for python)"

cmd="${1:-}"
case "$cmd" in
  -h|--help|help)   usage; exit 0;;
  version|-V|--version)
    printf 'gsvtk     repo CLI @ %s%s\n' "$(git_sha)" "$(git_dirty)"
    printf 'repo      %s\n' "$ROOT"
    exit 0;;
  repo)             printf '%s\n' "$ROOT"; exit 0;;
  locate)   shift; cmd_locate "$@";;
  doctor)   shift; cmd_doctor "$@";;
  tools)    shift; cmd_tools "$@";;
  check)    shift; if [ "${1:-}" = "image" ]; then shift; cmd_check_image "$@"; fi
            compat_note; cmd_check "$@";;
  gate)     shift; compat_note; cmd_check "$@";;        # older alias of check
  entity)   shift; compat_note; cmd_entity "$@";;
  compat)   shift
            case "${1:-}" in check|table|note) ;; *) set -- check "$@";; esac
            cd "$ROOT" || die "cd failed"; exec "$PY" scripts/check_compat.py "$@";;
  publish)  shift; cmd_publish "$@";;   # read-only: no gate
  publish-check) shift; cmd_publish --check "$@";;   # reads Dockstore and the branch tip, both GETs
  build)    shift; cmd_build "$@";;
  terra)    shift; cmd_terra "$@";;
  compare)  shift; cmd_compare "$@";;
  replay)   shift; cmd_replay "$@";;
  '')       usage >&2; exit 2;;
  *)        printf 'gsvtk: unknown command "%s". Run: gsvtk --help\n' "$cmd" >&2; exit 2;;
esac
