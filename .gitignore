# ----------------------------------------------------------------- config
# Real project / workspace / registry coordinates stay out of the repo.
# testkit.env.example is the committed template.
testkit.env
testkit.local.env
*.local.env
.env

# ------------------------------------------------------------------ scratch
# Everything the tools produce is regenerable and large: staged reference/batch
# inputs (tens of GB), local replay runs, frozen manifests, Terra recon dumps,
# fetched outputs, Cromwell metadata, gatk-sv-profile trees, VCFs.
/work/
work/
staging/
runs/
runs_*/
recon/
manifests/
outputs/
metadata/
compare_*/
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bed.gz
*.bed.gz.tbi
*.txt.gz
*.txt.gz.tbi
*.bam
*.bai
*.parquet
*.dict
*.cutoffs
*.MetricFile
*_metric_file.txt
*_geno_params.tsv
*_sepcutoff.txt

# --------------------------------------------------------------- build/log
*.log
*.out
__pycache__/
*.py[cod]
.venv*/
# `.venv*/` needs a DIRECTORY, so it does not match the `.venv` SYMLINK that exists in a linked git
# worktree (where the interpreter is shared rather than copied). Left unignored, `git add -A` stages it
# as mode 120000 and its blob content IS the absolute path of whoever made the worktree -- a machine
# coordinate entering the tracked set, which is what `make audit` exists to stop. Name it exactly.
.venv
venv/
.mypy_cache/
.ruff_cache/
.DS_Store
.ipynb_checkpoints/

# ------------------------------------------------------------- vendored
# WDLs are fetched from your gatk-sv checkout by scripts/fetch_wdl.py rather
# than committed, so they can never go stale against gatk-sv main.
/wdl/
vendor/wdl/
# Stray shell redirects. An empty `foo.stderr` in the repo root is an accident, not an
# artifact -- and `git add -A` will happily publish it (two turned up during review).
/*.stderr
/*.stdout

# any testkit.*.env profile is machine-local: it holds real project / workspace
# coordinates, and the loader picks profiles by exact name, so a stray one is inert but
# still committable. Only testkit.env.example is tracked.
testkit.*.env

# audit.local.txt holds YOUR identifiers for scripts/audit.py: personal by definition, so it
# is never tracked. audit.local.example is the committed template.
audit.local.txt

# .pi/skills/ is shipped documentation and stays tracked. .pi/goals/ is the goal tool's own state:
# a JSONL event log of task evidence, and the reports independent auditors wrote back. Those
# transcripts quote real paths verbatim -- the second audit's own report named this machine's
# gatk-sv checkout, and `make audit` correctly reported a leak that the *tool* had introduced.
# So the boundary is here, not a waiver: session state is never publishable, however accurate it is.
.pi/goals/
.pi/.goals-pool-snapshot.json

# Session records. Two directories, not three: docs/handoff/ is the numbered progress notes and
# docs/archive/ is the as-run dump (scripts that ran against the real cohort, a captured run's input
# JSON, the checkpoint and plan files). Both stay on disk here and neither ships.
#
# This is NOT an unpublish, and the distinction is the whole point of scripts/audit_history.py: the
# blobs stay reachable from history and still render at their commit URLs. Ignoring a path stops the
# working-tree audit from grading it (audit grades `git ls-files`, and an ignored file is never
# pushed), while the history audit keeps finding whatever those commits and blobs already published.
docs/archive/
docs/handoff/

# Tool-local state: editor/agent settings, lock files, per-machine project config. Not repo content --
# and while untracked they were enough to make `git status` report a dirty tree, which is the check
# worktree isolation runs before handing a review or implementation lane its own checkout.
.claude/
.serena/
