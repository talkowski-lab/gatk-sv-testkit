# gatk-sv-testkit profile — copy to testkit.env and edit.
#
#   cp testkit.env.example testkit.env
#   ./kit/gsvtk-config doctor
#
# Plain KEY=value so bash can source it and Python can parse it with no
# dependency. Already-exported environment variables win over anything here, so
# a one-off run is `GSVTK_PROJECT=other-project docker/gatk-sv-build.sh my-branch`.
#
# testkit.env and testkit.local.env are gitignored: keep real coordinates out of
# the repository. Two keys have no default at all — PROJECT and the Terra
# workspace — because guessing them means spending somebody else's money or
# writing into somebody else's workspace.

# ------------------------------------------------------------------ gcp
# Project used to run the throwaway builder/probe VMs. It is also where the
# images land by default. Use a project you can afford to burn: a build is an
# e2-standard-8 for 1-3 hours.
GSVTK_PROJECT=your-dev-project

# Where those VMs boot. gatk-sv images are linux/amd64 and the builder needs
# native amd64, so keep this in a region with amd64 stock.
GSVTK_ZONE=us-central1-a
GSVTK_MACHINE_TYPE=e2-standard-8
GSVTK_DISK_GB=150

# --------------------------------------------------------------- images
# Push target. Default derives as:
#     us.gcr.io/$GSVTK_PROJECT/$GSVTK_IMAGE_NAMESPACE/gatk-sv
# The namespace segment is the guard rail: never point it at a registry path an
# existing pipeline reads, or a test build silently becomes the image the
# pipeline runs.
GSVTK_IMAGE_NAMESPACE=test
#GSVTK_IMAGE_REPO=us.gcr.io/your-dev-project/test/gatk-sv
#GSVTK_GATK_IMAGE_REPO=us.gcr.io/your-dev-project/test/gatk

# ----------------------------------------------------------------- repos
# What the builder VM clones. Override to build from a fork, or to build a fork
# of a fork.
GSVTK_GATK_SV_REPO_URL=https://github.com/broadinstitute/gatk-sv
GSVTK_GATK_REPO_URL=https://github.com/broadinstitute/gatk

# Local clones, used by the WDL fetcher and the static checks so they read the
# bytes you are actually testing instead of re-cloning. Both must be git repos.
GSVTK_GATK_SV_CHECKOUT=/Users/you/IdeaProjects/gatk-sv
#GSVTK_GATK_CHECKOUT=/Users/you/IdeaProjects/gatk

# ----------------------------------------------------------------- terra
# Terra's Rawls API. api.terra.bio does not resolve on every network; the
# api.firecloud.org alias does, so it is the default here.
GSVTK_TERRA_API_ROOT=https://api.firecloud.org/api/

# Your sandbox workspace — the one the head-to-head configs write into.
# Copy an existing one into your own namespace first; never point these at a
# shared/featured workspace, the harness creates method configs and submissions.
GSVTK_TERRA_NAMESPACE=your-namespace
GSVTK_TERRA_WORKSPACE=GATK-SV-head-to-head

# sample_set entity holding the batch-level inputs/outputs. gatk-sv's 1KG
# reference-panel workspace calls it all_samples.
GSVTK_BATCH=all_samples

# ----------------------------------------------------------------- paths
# Scratch tree for staged inputs, local replay runs, frozen manifests, recon
# dumps and fetched outputs. Everything under here is regenerable and ignored
# by git; put it on a disk that can hold a full batch (tens of GB).
#GSVTK_WORK=/Volumes/scratch/gatk-sv-testkit
