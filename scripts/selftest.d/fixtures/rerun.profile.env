# Fixture profile for the rerun selftest (scripts/selftest.d/rerun.sh).
#
# PLACEHOLDERS ONLY, in the vocabulary testkit.env.example already uses: this file is tracked, so it
# must hold no real project, workspace, registry or bucket coordinate, and it must regenerate the
# goldens on any machine with no user config. See scripts/selftest.d/golden/.
GSVTK_TERRA_NAMESPACE=your-namespace
GSVTK_TERRA_WORKSPACE=GATK-SV-head-to-head
GSVTK_BRANCH=your-branch-under-test
GSVTK_IMAGE_REPO=us.gcr.io/your-dev-project/test/gatk-sv:YOUR_TAG
GSVTK_GATK_IMAGE_REPO=us.gcr.io/your-dev-project/test/gatk:YOUR_TAG
